# ⚡ VENOM TempMail Configuration

# Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Web Server Port (for UptimeRobot and keep-alive pings)
PORT=3000

# Polling Interval in Milliseconds (Default: 4000ms = 4 seconds)
POLL_INTERVAL_MS=4000

# (Optional) Public URL for Auto Self-Ping Keep-Alive on Render/Koyeb
APP_URL=https://your-bot-name.onrender.com

# Admin Telegram IDs (comma-separated, optional)
ADMIN_IDS=12345678,87654321

# Database File Path
DB_PATH=./data/database.json
